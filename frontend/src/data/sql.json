      {
        "cmd": "CREATE DATABASE dbname;",
        "desc": "创建数据库",
        "example": "CREATE DATABASE mydb;"
      },
      {
        "cmd": "DROP DATABASE dbname;",
        "desc": "删除数据库",
        "example": "DROP DATABASE olddb;"
      },
      {
        "cmd": "ALTER DATABASE dbname RENAME TO newname;",
        "desc": "重命名数据库",
        "example": "ALTER DATABASE mydb RENAME TO newdb;"
      },
      {
        "cmd": "CREATE TABLE table_name (column1 datatype, ...);",
        "desc": "创建表",
        "example": "CREATE TABLE users (id SERIAL, name VARCHAR(50));"
      },
      {
        "cmd": "DROP TABLE table_name;",
        "desc": "删除表",
        "example": "DROP TABLE users;"
      },
      {
        "cmd": "ALTER TABLE table_name ADD COLUMN column_name datatype;",
        "desc": "添加列",
        "example": "ALTER TABLE users ADD COLUMN email VARCHAR(100);"
      },
      {
        "cmd": "ALTER TABLE table_name DROP COLUMN column_name;",
        "desc": "删除列",
        "example": "ALTER TABLE users DROP COLUMN email;"
      },
      {
        "cmd": "INSERT INTO table (col1, col2) VALUES (val1, val2);",
        "desc": "插入数据",
        "example": "INSERT INTO users (name, age) VALUES ('John', 25);"
      },
      {
        "cmd": "UPDATE table SET col = val WHERE condition;",
        "desc": "更新数据",
        "example": "UPDATE users SET age = 26 WHERE name = 'John';"
      },
      {
        "cmd": "DELETE FROM table WHERE condition;",
        "desc": "删除数据",
        "example": "DELETE FROM users WHERE age > 30;"
      },
      {
        "cmd": "SELECT col1, col2 FROM table WHERE condition;",
        "desc": "查询数据",
        "example": "SELECT name, age FROM users WHERE age > 25;"
      },
      {
        "cmd": "CREATE USER username WITH PASSWORD 'password';",
        "desc": "创建用户",
        "example": "CREATE USER john WITH PASSWORD 'secret';"
      },
      {
        "cmd": "ALTER USER username WITH PASSWORD 'newpassword';",
        "desc": "修改用户密码",
        "example": "ALTER USER john WITH PASSWORD 'newsecret';"
      },
      {
        "cmd": "GRANT privilege ON table TO username;",
        "desc": "授予权限",
        "example": "GRANT SELECT ON users TO john;"
      },
      {
        "cmd": "REVOKE privilege ON table FROM username;",
        "desc": "撤销权限",
        "example": "REVOKE SELECT ON users FROM john;"
      },
      {
        "cmd": "CREATE INDEX index_name ON table (column);",
        "desc": "创建索引",
        "example": "CREATE INDEX idx_users_name ON users (name);"
      },
      {
        "cmd": "EXPLAIN ANALYZE query;",
        "desc": "分析查询性能",
        "example": "EXPLAIN ANALYZE SELECT * FROM users;"
      },
      {
        "cmd": "VACUUM FULL table;",
        "desc": "清理和优化表空间",
        "example": "VACUUM FULL users;"
      },
      {
        "cmd": "BEGIN; ... COMMIT;",
        "desc": "事务处理",
        "example": "BEGIN; UPDATE accounts SET balance = balance - 100; COMMIT;"
      }
    ]
  },
